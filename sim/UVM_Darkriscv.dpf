  - language: verilog
    path: filelist_V.txt
    library_name: dut
    options: '-uvm 1.2'
    file_list: relative-to-file
  - language: verilog
    path: filelist_V_clk.txt
    library_name: DUT_CLK
    options: '-uvm 1.2 -define TEST_CLK=1'
    file_list: relative-to-file
